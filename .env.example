# ============================================================================
# AI News 追踪体系 — 环境变量模板
# ============================================================================
# 复制为 .env 后填入你自己的值（.env 已被 .gitignore 忽略，切勿提交真实 key）。
# 在 GitHub Actions 中，这些值配置在 Settings → Secrets and variables → Actions。
# ★ = 主流水线（daily_news）最小必需
# ----------------------------------------------------------------------------

# ---- 火山方舟 ARK（豆包大模型）★ -------------------------------------------
VOLC_API_KEY=                       # ★ 火山控制台 → 火山方舟 → API Key（账单归你，务必充值+余额告警）
VOLC_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3   # 默认即可，一般不填

# 模型 ID（有默认值，通常不用改）
DOUBAO_FILTER_MODEL=doubao-1-5-pro-32k-250115     # 初筛模型
DOUBAO_ANALYZE_MODEL=doubao-seed-1-6-251015       # 深度分析模型

# ---- 飞书自建应用 ★ --------------------------------------------------------
FEISHU_APP_ID=                      # ★ open.feishu.cn/app 自建应用 App ID
FEISHU_APP_SECRET=                  # ★ 同上应用 App Secret

# ---- 飞书表 / 文档 URL ------------------------------------------------------
FEISHU_BITABLE_URL=                 # ★ 初筛结果多维表格 URL
FEISHU_KNOWLEDGE_BASE_URL=          # 战略判断知识库表格 URL（深度分析用）
FEISHU_DAILY_REPORT_URL=            # 每日报告文档 URL（深度分析用）
FEISHU_KOL_DIGEST_URL=              # KOL 摘要文档 URL（kol_digest workflow 用）
FEISHU_BIWEEKLY_REPORT_URL=         # 双周报文档 URL（biweekly workflow 用）

# ---- 抓取窗口 ----------------------------------------------------------------
NEWS_HOURS_LIMIT=24                 # 只保留最近 N 小时文章

# ---- Wechat2RSS（微信公众号源自动同步）-------------------------------------
WECHAT2RSS_BASE_URL=                # 你的 Wechat2RSS 部署地址，如 https://wechat2rss.xxx.com
WECHAT2RSS_TOKEN=                   # 若 Wechat2RSS 需要鉴权

# ---- 安全试跑开关 ------------------------------------------------------------
DISABLE_FEISHU_WRITE=               # 置 1 则只产出本地 JSON、不写飞书

# ---- 播客增强（火山语音 ASR，缺则自动跳过）--------------------------------
VOLC_ASR_APPID=
VOLC_ASR_TOKEN=
VOLC_ASR_RESOURCE_ID=
PODCAST_ADMIN_EMAIL=

# ---- Twitter 增强（SocialData，缺则自动跳过）-------------------------------
SOCIALDATA_API_KEY=

# ---- AI News Radar 前端发布（缺则自动跳过）--------------------------------
AI_NEWS_RADAR_DEPLOY_KEY=
AI_TO_C_MODEL=
